{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/hrms/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/sheets/sync?mode=append",
      "schedule": "*/15 * * * *"
    },
    {
