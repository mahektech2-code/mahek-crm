{
  "_comment": "Dates are listed per year because festival dates move; NOTHING here is extrapolated to another year. An entry with source null would be shown as UNVERIFIED. Update only from an official or panchang source, and record it under sources.",
  "sources": {
    "dopt-2026": {
      "title": "Government of India DoP&T holidays for 2026 (Delhi / New Delhi central offices)",
      "reference": "O.M. F.No.12/2/2023-JCA dated 03.07.2025, Annexure-I (gazetted) and Annexure-II (restricted)",
      "transcribedFrom": "https://cdnbbsr.s3waas.gov.in/s32d2ca7eedf739ef4c3800713ec482e1a/uploads/2025/10/2025103171.pdf (Kendriya Vidyalaya Sangathan circular dated 29.10.2025 on a government-hosted site, enclosing the DoP&T O.M. and both annexures as scanned pages, read by eye)",
      "retrievedOn": "2026-10-22",
      "verification": "official-list",
      "caveat": "Read from the scanned O.M. itself and all 31 festival entries compared one by one with Annexure-I and II (an earlier version of this file was copied from a news site). It is the Delhi / New Delhi list; the O.M. lets Id-ul-Fitr, Id-ul-Zuha, Muharram and Id-e-Milad move with the moon, and offices outside Delhi follow state lists. Later amendments are listed as separate sources. Not independently checked against a state panchang."
    },
    "dopt-2027": {
      "title": "Government of India DoP&T holidays for 2027 (Delhi / New Delhi central offices)",
      "reference": "O.M. F.No.12/2/2023-JCA dated 16.07.2026, Annexure-I (gazetted) and Annexure-II (restricted)",
      "transcribedFrom": "https://utilities.cept.gov.in/dop/pdfbind.ashx?id=15435 (Department of Posts letter No. Y-21/2/2026-PE-II-DOP dated 08-09-2026, which encloses the DoP&T O.M.; government-hosted, scanned pages read by eye)",
      "retrievedOn": "2026-10-22",
      "verification": "official-list",
      "caveat": "Read from the scanned O.M. itself and all 31 dates compared one by one. It is the Delhi / New Delhi list; the O.M. lets Id-ul-Fitr, Id-ul-Zuha, Muharram and Id-e-Milad move with the moon, and offices outside Delhi follow state lists. Not independently checked against a state panchang."
    },
    "pib-2026-05-22": {
      "title": "PIB release, Ministry of Personnel, Public Grievances & Pensions: change in date of holiday on account of Id-ul-Zuha (Bakrid)",
      "reference": "Posted 22 May 2026, Release ID 2264022: Delhi / New Delhi central offices closed on 28 May 2026 in place of 27 May 2026",
      "transcribedFrom": "https://www.pib.gov.in/PressReleasePage.aspx?PRID=2264022&reg=3&lang=2",
      "retrievedOn": "2026-10-22",
      "verification": "official-list",
      "caveat": "Applies to central offices in Delhi / New Delhi. Offices elsewhere follow their state decision."
    },
    "dopt-2026-04-09": {
      "title": "Holiday on 14 April 2026, birth anniversary of Dr. B.R. Ambedkar",
      "reference": "DoP&T O.M. No. 12/4/2020-JCA dated 09.04.2026, as conveyed in Ministry of Jal Shakti O.M. F.No. A-50013/122/2024-Admn dated 09.04.2026",
      "transcribedFrom": "https://mowr.nic.in/core/Circulars/2026/Admin_09-04-2026_1156.pdf (government-hosted; the Ministry's own memorandum, read by eye; the enclosed DoP&T O.M. was not read separately)",
      "retrievedOn": "2026-10-22",
      "verification": "official-list",
      "caveat": "Declared as a holiday for central offices; it is in the past and is kept only for completeness."
    }
  },
