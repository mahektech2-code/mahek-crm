{
  "expo": {
    "name": "Mahek MBOS",
    "slug": "mbos",
    "version": "1.6.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.mahek.mbos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.mahek.mbos",
      "versionCode": 11,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "MahekOne lets you speak a note instead of typing it — what you say is written out in English for you to read and correct before it is saved. It is used for nothing else, and every box it appears on can still be typed into."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MahekOne records where a visit, an order or a payment was taken, and follows your route only while your day is open. It stops when you check out.",
          "locationAlwaysAndWhenInUsePermission": "MahekOne follows your route while your day is open, including with the screen off \u2014 a call between two shops should not leave a gap in the map. It stops the moment you check out.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "MahekOne takes a photo of you when you start your day, so the office can see the check-in was yours. It is used for nothing else, and the day starts whether or not you take one.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock MBOS with Face ID instead of typing a password."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5223E0"
        }
      ],
      "./plugins/withReleaseSigning.js",
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "mbos",
    "backgroundColor": "#F7F8FA",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/713eb7ff-b462-48c8-9b6a-b89d60bc9bbd",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "713eb7ff-b462-48c8-9b6a-b89d60bc9bbd"
      }
    },
    "owner": "dasabhinaba34"
  }
}
