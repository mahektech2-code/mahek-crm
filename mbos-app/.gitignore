# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# Both spellings, deliberately. A trailing slash matches a DIRECTORY and not a
# symlink of the same name — and a worktree that symlinks node_modules at the
# main checkout is exactly how one gets committed. It happened on this branch.
node_modules
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# The release keystore's password — kept out of git deliberately, see
# keystore/README.md. The keystore file itself IS committed.
/keystore/*.properties
