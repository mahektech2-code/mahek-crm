# ---------------------------------------------------------------------------
# Copy to .env.local and adjust if needed:   cp .env.example .env.local
#
# Development runs against Postgres on your own machine. Nobody shares a
# database, and nobody needs credentials to anyone else's cloud account.
# `npm run db:setup` creates the role, the database, the schema and the demo
# data for you.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://mahek:mahek@127.0.0.1:5432/mahekone"

# Preview and production use a Neon database on the company Vercel project.
# Those values live in Vercel, never in this file — pull them with:
#   vercel env pull .env.production.local

# Password reset links. Without these the mail is written to the server log
# instead of sent, which is what local development wants — set them and the
# same link goes out through Resend.
# RESEND_API_KEY="re_..."
# MAIL_FROM="MahekOne <no-reply@mahek.in>"

# Only needed where the request host is not the address people click, e.g. a
# tunnel. Otherwise the link is built from the incoming request.
# APP_URL="https://one.mahek.in"
