{
  "name": "mahek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local src/db/seed.ts",
    "demo:clear": "tsx --conditions=react-server --env-file=.env.local scripts/clear-demo-data.ts",
    "demo:clear:url": "tsx --conditions=react-server scripts/clear-demo-data.ts",
    "jobs": "tsx --conditions=react-server --env-file=.env.local scripts/run-job.ts",
    "catalogue:import": "tsx --conditions=react-server --env-file=.env.local scripts/import-catalogue.ts",
    "catalogue:parse": "node scripts/parse-catalogue.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:deploy": "drizzle-kit migrate",
    "check:links": "node --env-file=.env.local scripts/check-links.mjs",
    "test": "tsx --conditions=react-server --test src/lib/engines/*.test.ts src/lib/csv.test.ts src/lib/catalogue.test.ts src/lib/notes.test.ts",
    "test:db": "node --env-file=.env.local scripts/make-test-db.mjs",
    "test:integration": "node --env-file=.env.local scripts/run-integration.mjs",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5"
  }
}
