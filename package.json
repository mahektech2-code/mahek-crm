{
  "name": "mahek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "//deploy": "Migrations and the catalogue import used to run inside `build`, which worked while the build ran next to the database. It now runs on a GitHub runner with no route to Postgres, so they moved here and the deploy workflow calls this over an SSH tunnel.",
    "deploy:db": "npm run db:deploy && npm run catalogue:deploy",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local src/db/seed.ts",
    "demo:clear": "tsx --conditions=react-server --env-file=.env.local scripts/clear-demo-data.ts",
    "demo:clear:url": "tsx --conditions=react-server scripts/clear-demo-data.ts",
    "jobs": "tsx --conditions=react-server --env-file=.env.local scripts/run-job.ts",
    "jobs:prod": "tsx --conditions=react-server --env-file=.env.prod.local scripts/run-job.ts",
    "jobs:prod:sheets": "tsx --conditions=react-server --env-file=.env.local --env-file=.env.prod.local scripts/run-job.ts",
    "app:grant": "tsx --conditions=react-server --env-file=.env.local scripts/grant-app.ts",
    "user:role": "tsx --conditions=react-server --env-file=.env.local scripts/set-role.ts",
    "salesman:link": "tsx --conditions=react-server --env-file=.env.local scripts/link-salesman-name.ts",
    "salesman:link:prod": "tsx --conditions=react-server --env-file=.env.prod.local scripts/link-salesman-name.ts",
    "employee:link": "tsx --conditions=react-server --env-file=.env.local scripts/link-employee.ts",
    "employee:link:prod": "tsx --conditions=react-server --env-file=.env.prod.local scripts/link-employee.ts",
    "field:diagnose": "tsx --conditions=react-server --env-file=.env.local scripts/diagnose-field-book.ts",
    "field:diagnose:prod": "tsx --conditions=react-server --env-file=.env.prod.local scripts/diagnose-field-book.ts",
    "users:accounts": "tsx --conditions=react-server --env-file=.env.local scripts/create-accounts-users.ts",
    "users:accounts:url": "tsx --conditions=react-server scripts/create-accounts-users.ts",
    "hrms:sync": "tsx --conditions=react-server --env-file=.env.local scripts/run-job.ts hrms-sync",
    "jobs:field-activity-csv": "tsx --conditions=react-server --env-file=.env.local scripts/import-field-activity-csv.ts",
    "jobs:customer-locations-csv": "tsx --conditions=react-server --env-file=.env.local scripts/import-customer-locations-csv.ts",
    "catalogue:import": "tsx --conditions=react-server --env-file=.env.local scripts/import-catalogue.ts",
    "catalogue:deploy": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/import-catalogue.ts",
    "catalogue:parse": "node scripts/parse-catalogue.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:deploy": "node scripts/migrate-deploy.mjs",
    "check:storage": "tsx --conditions=react-server --env-file=.env.local scripts/check-storage.mts",
    "check:links": "node --env-file=.env.local scripts/check-links.mjs",
    "test": "tsx --conditions=react-server --test src/lib/engines/*.test.ts src/lib/expense-rule-forms.test.ts src/lib/s3-signing.test.ts src/lib/storage-s3.test.ts src/lib/csv.test.ts src/lib/catalogue.test.ts src/lib/notes.test.ts src/lib/hr-parse.test.ts src/lib/taken-order-parse.test.ts src/lib/business-date.test.ts src/lib/voice-readiness.test.ts src/lib/modules.test.ts src/lib/env-names.test.ts src/lib/outstanding-parse.test.ts src/lib/field-activity-parse.test.ts src/lib/field-activity-match.test.ts src/lib/road-legs.test.ts src/lib/india-states.test.ts src/lib/territory-sql.test.ts src/lib/employee-match.test.ts src/lib/customer-location-parse.test.ts src/lib/customer-master-parse.test.ts src/lib/mbos-wire.test.ts src/lib/app-routing.test.ts src/lib/order-status.test.ts src/lib/timeline-coverage.test.ts src/lib/handover.test.ts src/lib/engines/opportunity.test.ts src/lib/mbos/push-rules.test.ts",
    "mbos:sync-engines": "node scripts/sync-mbos-engines.mjs",
    "test:db": "node --env-file=.env.local scripts/make-test-db.mjs",
    "test:integration": "node --env-file=.env.local scripts/run-integration.mjs",
    "test:accounts": "node --env-file=.env.local scripts/run-accounts-tests.mjs",
    "test:all": "npm run test && npm run test:integration",
    "receivables": "tsx --conditions=react-server --env-file=.env.local scripts/apply-receivables.ts",
    "receivables:prod": "tsx --conditions=react-server --env-file=.env.prod.local scripts/apply-receivables.ts",
    "outstanding": "tsx --conditions=react-server --env-file=.env.local scripts/apply-outstanding.ts",
    "outstanding:prod": "tsx --conditions=react-server scripts/apply-outstanding.ts",
    "test:owner": "node --env-file=.env.local scripts/run-owner-tests.mjs",
    "test:performance": "node --env-file=.env.local scripts/run-performance-tests.mjs",
    "test:outstanding": "node --env-file=.env.local scripts/run-outstanding-tests.mjs",
    "outstanding:restore": "tsx --conditions=react-server scripts/restore-outstanding-snapshot.ts",
    "outstanding:snapshot": "tsx --conditions=react-server scripts/snapshot-outstanding.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "ai": "^7.0.58",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.4",
    "typescript": "^5"
  }
}
