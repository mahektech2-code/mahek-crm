# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed — `npm run db:setup` copies it.
!.env.example
# The production example is DOCUMENTATION and belongs in the repository: it is
# the list of names the deployment must set, and a test asserts it matches what
# the code reads. It carries no values. Without this line `.env*` swallowed it,
# so it lived on one laptop and CI could not see the file it was checking.
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# throwaway scripts written against a live database while working something out
# — never part of the app, and one `git add -A` away from being committed.
scratch-*.mjs
*.tmp.mjs
