# The only thing on this box the internet can reach.
#
# Caddy obtains and renews the certificate itself, so TLS is not a thing
# anybody has to remember in fourteen months' time. That matters more here than
# it does on a managed platform: on Vercel the certificate was somebody else's
# problem, and an expired one on a self-hosted box is a Monday morning where
# nobody can sign in.

{
	# Where Let's Encrypt writes when something is wrong with a renewal.
	email {$ACME_EMAIL:admin@mahek.in}
	# The staging endpoint has far kinder rate limits. Uncomment while testing
	# the cutover against a throwaway subdomain, then comment it out again —
	# certificates it issues are NOT trusted by browsers.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# WHO THE VISITOR IS, BEHIND CLOUDFLARE.
	#
	# With a host's record orange in Cloudflare, every connection arrives from
	# a Cloudflare address and the visitor's own is in CF-Connecting-IP. The
	# app reads the visitor from X-Forwarded-For — the sign-in throttle
	# (sign-in-throttle.ts) counts attempts per address, and Locker's audit
	# records it — so without this every person behind one Cloudflare edge is
	# one address, and one person's wrong passwords lock out a city.
	#
	# The header is believed ONLY from these ranges. A request straight to the
	# droplet (a grey record, or anybody who knows the IP) cannot name itself:
	# its peer is not trusted, so {client_ip} is the real peer, exactly as
	# before. Each reverse_proxy below sends {client_ip} on as X-Forwarded-For
	# and X-Real-IP, overwriting whatever the request carried.
	#
	# Cloudflare's published list, https://www.cloudflare.com/ips — it changes
	# rarely and announces changes in advance. Checked 2026-11-18.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	# COMPRESSED, EXCEPT FOR THE ONE RESPONSE THAT IS A CONNECTION.
	#
	# The Live map holds an open `text/event-stream` (see
	# `src/app/api/sales/live/stream/route.ts`), and a compressor that buffers
	# would hold every event until it had a block worth flushing — a map that
	# has silently stopped, on a connection that reports itself perfectly
	# healthy, which is exactly the failure the stream was built to end. Caddy
	# is believed to pass Flush through its encoder; this does not depend on
	# that belief.
	#
	# The list below is Caddy's own default set with `text/*` spelled out as the
	# three text types actually worth compressing, so `text/event-stream` is
	# simply not in it. The response also sends `Content-Encoding: identity` and
	# `Cache-Control: no-transform`, and the browser falls back to polling if
	# nothing arrives regardless — three defences, because a buffered stream
	# looks identical to a working one from every end.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
			header Content-Type application/font*
			header Content-Type application/vnd.ms-fontobject
			header Content-Type application/x-font*
		}
	}

	# The MBOS APK, served straight off disk. Placed at
	# /opt/mahekone/downloads/mbos.apk by hand — never built into the app
	# image, so a 90+ MB binary never touches the 500 MB container registry
	# (see the deploy job's own comments on that quota), and shipping an
	# update is "replace the file on the droplet", no deploy required.
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	# The app publishes no port to the host; this is the only route to it.
	#
	# ONE OR TWO RENDERERS, named by APP_UPSTREAMS (docker-compose.yml): "app:3000"
	# on a 1 vCPU box, "app:3000 app2:3000" once there is a second core to run
	# the second on. The placeholder is replaced before the Caddyfile is read, so
	# a space in it is two upstreams.
	#
	# LEAST BUSY, NOT TURN ABOUT. A Node process draws one page at a time, so the
	# request to send a process is the one that will not queue behind somebody's
	# 300 ms ERP list — whichever has fewer requests open. A process that refuses
	# a connection (stopped for a deploy) is skipped for five seconds and the
	# request goes to the other, which is what makes a deploy with both running
	# drop nothing.
	reverse_proxy {$APP_UPSTREAMS:app:3000} {
		lb_policy least_conn
		fail_duration 5s
		# A DEPLOY IS A FEW SECONDS WITH NO APP, and a save made in them used
		# to fail outright. `restart.sh` recreates the one app container: the
		# old one stops, the new one boots, and for that gap every request got
		# a 502 — which reads, to somebody pressing Save, as the button doing
		# nothing, and refreshing a moment later "fixed" it. With this Caddy
		# holds a request it cannot connect with and tries again every quarter
		# second for up to 30 seconds, so the save waits out the restart
		# instead of being lost. Caddy only retries a request it never managed
		# to SEND, so a POST is never run twice.
		lb_try_duration 30s
		lb_try_interval 250ms

		# The visitor, as the global `servers` block worked it out — never a
		# header the request brought with it.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}

		# Server Actions and dictation uploads are POSTs that take a while.
		# Two minutes of Opus audio is a slow request, not a hung one.
		#
		# THE LIVE MAP'S STREAM IS DELIBERATELY SHORTER THAN THIS. Whatever
		# exactly these deadlines apply to, a response that never ends is the
		# one shape that can run into them — so the stream closes itself after
		# `mbos.location.liveStreamMinutes`, capped at four in the registry, and
		# the browser opens another. A connection that ends on our own terms
		# cannot be cut on somebody else's. Raise that cap and this is the line
		# that has to move with it.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# Next fingerprints these filenames, so they can be cached hard.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		# Neither of these was set on Vercel either, but a browser landing on
		# an accounts app should not be guessing about content types or
		# advertising where it came from.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# 25 GiB of disk and no log rotation is a full disk in a few months,
		# which on this box takes Postgres down with it.
	}
}

# THE CUSTOMER-FACING HOST — tracking links, consignment links and vendor POs.
# The same app answers it, but the app itself refuses every other path on this
# host (src/lib/public-links.ts), so it is not a second door into the
# workspace, and the workspace's own address never reaches a customer. The app
# sends links out on this host only once PUBLIC_LINK_HOST is set in .env, so
# add this block and the DNS record first, then set the variable.
{$PUBLIC_LINK_HOST:track.mahekindia.com} {
	encode zstd gzip

	reverse_proxy {$APP_UPSTREAMS:app:3000} {
		lb_policy least_conn
		fail_duration 5s
		lb_try_duration 30s
		lb_try_interval 250ms
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# A token link is a key; it must never be indexed.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	log {
		output file /data/public-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
