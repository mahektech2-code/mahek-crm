# The only thing on this box the internet can reach.
#
# Caddy obtains and renews the certificate itself, so TLS is not a thing
# anybody has to remember in fourteen months' time. That matters more here than
# it does on a managed platform: on Vercel the certificate was somebody else's
# problem, and an expired one on a self-hosted box is a Monday morning where
# nobody can sign in.

{
	# Where Let's Encrypt writes when something is wrong with a renewal.
	email {$ACME_EMAIL:admin@mahek.in}
	# The staging endpoint has far kinder rate limits. Uncomment while testing
	# the cutover against a throwaway subdomain, then comment it out again —
	# certificates it issues are NOT trusted by browsers.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	# COMPRESSED, EXCEPT FOR THE ONE RESPONSE THAT IS A CONNECTION.
	#
	# The Live map holds an open `text/event-stream` (see
	# `src/app/api/sales/live/stream/route.ts`), and a compressor that buffers
	# would hold every event until it had a block worth flushing — a map that
	# has silently stopped, on a connection that reports itself perfectly
	# healthy, which is exactly the failure the stream was built to end. Caddy
	# is believed to pass Flush through its encoder; this does not depend on
	# that belief.
	#
	# The list below is Caddy's own default set with `text/*` spelled out as the
	# three text types actually worth compressing, so `text/event-stream` is
	# simply not in it. The response also sends `Content-Encoding: identity` and
	# `Cache-Control: no-transform`, and the browser falls back to polling if
	# nothing arrives regardless — three defences, because a buffered stream
	# looks identical to a working one from every end.
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/atom+xml*
			header Content-Type application/rss+xml*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
			header Content-Type application/font*
			header Content-Type application/vnd.ms-fontobject
			header Content-Type application/x-font*
		}
	}

	# The MBOS APK, served straight off disk. Placed at
	# /opt/mahekone/downloads/mbos.apk by hand — never built into the app
	# image, so a 90+ MB binary never touches the 500 MB container registry
	# (see the deploy job's own comments on that quota), and shipping an
	# update is "replace the file on the droplet", no deploy required.
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}

	# The app publishes no port to the host; this is the only route to it.
	reverse_proxy app:3000 {
		# Server Actions and dictation uploads are POSTs that take a while.
		# Two minutes of Opus audio is a slow request, not a hung one.
		#
		# THE LIVE MAP'S STREAM IS DELIBERATELY SHORTER THAN THIS. Whatever
		# exactly these deadlines apply to, a response that never ends is the
		# one shape that can run into them — so the stream closes itself after
		# `mbos.location.liveStreamMinutes`, capped at four in the registry, and
		# the browser opens another. A connection that ends on our own terms
		# cannot be cut on somebody else's. Raise that cap and this is the line
		# that has to move with it.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# Next fingerprints these filenames, so they can be cached hard.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		# Neither of these was set on Vercel either, but a browser landing on
		# an accounts app should not be guessing about content types or
		# advertising where it came from.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# 25 GiB of disk and no log rotation is a full disk in a few months,
		# which on this box takes Postgres down with it.
	}
}
