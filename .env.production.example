# Lives at /opt/mahekone/.env on the droplet. NEVER committed — this file is
# the shape of it, with the values removed.
#
#   chmod 600 /opt/mahekone/.env
#
# Docker Compose reads it, and the app container is handed it whole.
#
# The names here are the ones the CODE reads. They were checked against
# `grep -rhoE 'process\.env\.[A-Z0-9_]+' src scripts`, not written from memory
# — an invented name does not fail loudly, it makes a feature go quiet: the
# microphone simply stops being drawn, the sheet sync reports "not configured".

# ---------------------------------------------------------------- the basics
# The domain Caddy obtains a certificate for. Its A record must already point
# at this droplet before the first start, or Let's Encrypt cannot verify it.
DOMAIN=one.mahekindia.com
ACME_EMAIL=mahektech2@gmail.com

# Written by the deploy workflow on every deploy. Set it by hand the first
# time, to the tag you want to start with.
IMAGE=registry.digitalocean.com/mahekone/app:latest

# Generate once, keep somewhere safe, never rotate casually — it is also the
# GitHub secret the migration step uses.
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=

# Ten is right for a 1 GiB box; see the reasoning in src/db/index.ts.
DATABASE_POOL_MAX=10

# Prepared statements are ON unless this says the word "false". They are safe
# here because the app talks to Postgres directly — set it to false if a
# pgbouncer in transaction mode is ever put in front, or if a generic plan
# turns out worse than a per-call one. See src/db/index.ts.
# DATABASE_PREPARE=false

# Where the app thinks it lives. Reset links and anything else that has to
# build an absolute URL read this, so a stale value mails people a dead link.
APP_URL=https://one.mahekindia.com

# --------------------------------------------------------- offsite backups
# Cloudflare R2. Free to 10 GB and free to read back, so the offsite copy of a
# ~40 MB dump costs nothing. Leaving these blank means backups exist only on
# the droplet, which backup.sh warns about loudly and which you should not run
# this way for long.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=mahekone-backups

# ------------------------------------------------------------------- google
# The service account that reads the workbooks. The private key is multi-line:
# keep it in double quotes with literal \n, exactly as Vercel stored it.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# The sheets themselves. HR_SHEET_ID is optional — employee-sync-service.ts
# hardcodes a default and this only overrides it, which is how a staging deploy
# points at a copy.
ORDERS_SHEET_ID=
ORDERS_SHEET_TAB=
PARTY_SHEET_ID=
PARTY_SHEET_TAB=
PAYMENTS_SHEET_TAB=
TAKEN_ORDER_SHEET_ID=
TAKEN_ORDER_SHEET_TAB=
HR_SHEET_ID=
FIELD_ACTIVITY_SHEET_ID=

# ---------------------------------------------------------------- the rest
# Guards /api/sheets/sync and /api/hrms/sync. The Apps Script trigger and the
# nightly workflow both send it.
CRON_SECRET=

# Without these, password-reset mail is written to the server log instead of
# being sent, and the screen says so rather than claiming it went.
RESEND_API_KEY=
MAIL_FROM=

# The field app signs its own tokens.
MBOS_JWT_SECRET=

# Optional — without it, attachment bytes stay in Postgres, which is the
# default and is right at this volume.
# BLOB_READ_WRITE_TOKEN=
